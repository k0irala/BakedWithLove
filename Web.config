<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!-- Database file lives in App_Data and is attached automatically by SQL Server Express LocalDB -->
    <add name="BakeryDB"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\BakedWithLove.mdf;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- EmailMode: "Pickup" saves e-mails as .eml files in App_Data\Emails (no setup needed).
         "Smtp" sends real e-mail using the smtp settings in system.net/mailSettings below. -->
    <add key="EmailMode" value="Pickup" />
    <add key="EmailFrom" value="orders@bakedwithlove.com" />
    <add key="DeliveryFee" value="100" />
    <add key="FreeDeliveryOver" value="2000" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="5120" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Default.aspx" />

    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="60" slidingExpiration="true" name=".BAKEDWITHLOVE" />
    </authentication>

    <authorization>
      <allow users="*" />
    </authorization>

    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID">
      <controls>
        <add tagPrefix="bwl" tagName="ProductCard" src="~/Controls/ProductCard.ascx" />
        <add tagPrefix="bwl" tagName="OrderTimeline" src="~/Controls/OrderTimeline.ascx" />
        <add tagPrefix="bwl" tagName="StarRating" src="~/Controls/StarRating.ascx" />
      </controls>
    </pages>
  </system.web>

  <!-- Member-only pages: any logged-in user -->
  <location path="Member">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>

  <!-- Admin-only pages -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- The database and saved e-mails are never served directly -->
  <location path="App_Data">
    <system.web>
      <authorization>
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <system.net>
    <mailSettings>
      <!-- Only used when EmailMode = Smtp. Fill in your own SMTP details (e.g. Gmail app password). -->
      <smtp from="orders@bakedwithlove.com">
        <network host="smtp.gmail.com" port="587" enableSsl="true" userName="" password="" />
      </smtp>
    </mailSettings>
  </system.net>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Let browsers cache images, CSS and JS for 7 days (site.css is versioned with ?v= in the master pages) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
  </system.webServer>

</configuration>
